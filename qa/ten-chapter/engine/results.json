      "piaoOuting=paperboat": {
        "count": 64,
        "nodes": [
          "tc_c07_piao_paperboat_return_001"
        ],
        "source": {
          "file": "项目文档/故事/全十章审阅稿/第七章-各自要过的日子.md",
          "line": 389,
          "raw": "**如果选过A：**我从她挪开的废纸里认出那只歪纸船，惊讶她真留到了现在。她说放在袋子夹层忘了扔，刚才翻出来，还能看见我声称的船头。我提议重折一次，她立刻把纸收远：“不行。这只是你当时的水平，不能修改历史。”我问那她自己的那只呢。她面不改色地说压平了，用过了。我们相互指责了一会儿，谁也没把船放进水里。"
        }
      },
      "piaoOuting=signs": {
        "count": 64,
        "nodes": [
          "tc_c07_piao_signs_return_001"
        ],
        "source": {
          "file": "项目文档/故事/全十章审阅稿/第七章-各自要过的日子.md",
          "line": 391,
          "raw": "**如果选过B：**纸袋上印着一家店的名字，她看着忽然想起“东西都在”。我接“先坐一会儿”，两个人都笑得像听见一个只有彼此才知道的笑话。她说那天后来才发现，卖沙发的旧招牌后面还有一层。我问是什么，她说没看清，留到下回再猜。我们没有为那家不存在的店设计菜单，光用它起的怪名字把半小时浪费掉一点，就已经够了。"
        }
      },
