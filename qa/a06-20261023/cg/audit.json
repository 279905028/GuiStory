    "qiuqiuSequence": [
      {
        "beat": "轻搭手",
        "node": "tc_c08_huangqiuqiu_her_decision_001",
        "form": "sphere",
        "file": "assets/ten-chapter/huangqiuqiu/char-huangqiuqiu-orb-hand-base.webp",
        "note": "A03姿态＋正文表达接触；不新增紧握或告白。",
        "text": "看够天空以后，她让我帮忙回到靠里的位置。我照着她说的慢慢放好，正准备收手，她的小手忽然碰住了我的手指。",
        "positionInLinearChain": 0,
        "nodeExists": true
      },
      {
        "beat": "她自主松开",
        "node": "tc_c08_huangqiuqiu_her_decision_010",
        "form": "sphere",
        "file": "assets/char-huangqiuqiu.webp",
        "text": "她没追问，嘴角有一点很浅的笑。我们就这么放了一会儿，直到她自己松开。我没有把这个动作立即变成一句必须回答的告白，她也没有假装刚才只是为了坐稳。",
        "positionInLinearChain": 9,
        "nodeExists": true
      },
      {
        "beat": "文文收手、退凳",
        "node": "tc_c08_huangqiuqiu_her_decision_019",
        "form": "sphere",
        "file": "assets/char-huangqiuqiu.webp",
        "text": "我把手收回膝上，问她要不要我往后坐一点。她点头，我便起身把凳子挪开。等空出一点地方，她才说好了。",
        "positionInLinearChain": 18,
        "nodeExists": true
      },
      {
        "beat": "轮廓变化",
        "node": "tc_c08_huangqiuqiu_her_decision_020",
        "form": "sphere",
        "file": "assets/char-huangqiuqiu.webp",
        "note": "由E08／E09淡出球形；不提前切人形，不加恋爱条件。",
        "text": "她坐直了一点，原本圆润的黄色轮廓在我眼前渐渐改变。肩背舒展开来，手臂落到身侧；等她把双脚踩稳，我才发现自己一直屏着气。",
        "positionInLinearChain": 19,
        "nodeExists": true
      },
      {
        "beat": "揭示人形并执行形态事件",
        "node": "tc_c08_huangqiuqiu_human_reveal",
        "form": "human",
        "file": "assets/ten-chapter/huangqiuqiu/char-huangqiuqiu-human-base.webp",
        "note": "先执行原有onEnter，再解析人形立绘和头像。",
        "text": "坐在我面前的，已经是个棕色齐刘海、中长发垂到肩旁的年轻女人。浅米灰色的宽松拉链外套敞着，里面是白色印花上衣，颈间有一圈黑色颈饰，一只眼前覆着白色遮片。她手里握着一根浅色的玩偶棒，长柄顶端是张圆圆的脸。",
        "positionInLinearChain": 20,
        "nodeExists": true
      },
      {
        "beat": "扶正玩偶棒的近景",
        "node": "tc_c08_huangqiuqiu_her_decision_025",
        "form": "human",
        "file": "assets/ten-chapter/cg/cg-qiuqiu-transform.webp",
        "text": "我笑了一下，终于把那口气呼出来。她低头整理袖口，玩偶棒差点碰到我的膝盖，又被她及时扶正。",
        "positionInLinearChain": 24,
        "nodeExists": true
      },
      {
        "beat": "退出CG继续聊天",
        "node": "tc_c08_huangqiuqiu_her_decision_028",
        "form": "human",
        "file": "assets/ten-chapter/huangqiuqiu/char-huangqiuqiu-human-base.webp",
        "text": "我重新坐下。她把玩偶棒靠在身边，自己将外套下摆拢好，挪到坐得舒服的位置。我没有伸手替她安排，她也没有急着让我夸这副模样。我们隔着刚才留出的那点距离，重新聊起晚饭。",
        "positionInLinearChain": 27,
        "nodeExists": true
      }
    ],
